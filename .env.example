# Shopify App
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_customers,read_customer_tags

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/zure_configurator

# App
NODE_ENV=development
APP_SECRET=change-this-to-a-random-secret-in-production
SESSION_SECRET=change-this-to-another-random-secret

# Local development — set this to your store's myshopify.com domain.
# This MUST match a row in the 'stores' table in your database.
# The seed script uses this value too, so set it before running seed.
# IGNORED when NODE_ENV=production.
DEV_STORE_DOMAIN=zure-dev-2.myshopify.com

# Redis (optional, Phase 2)
# REDIS_URL=redis://localhost:6379

# Deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000
