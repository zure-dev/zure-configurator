{% comment %}
  Zure Configurator — Theme App Extension Block
  Add this block to a product page in the Shopify theme editor.
  It renders the customer-facing product configurator.
{% endcomment %}

{% if product %}
  <div
    id="zure-configurator"
    data-shop="{{ shop.permanent_domain }}"
    data-product-id="{{ product.id }}"
    data-product-handle="{{ product.handle }}"
    data-app-url="{{ block.settings.app_url }}"
    data-currency="{{ shop.currency }}"
    style="margin: 24px 0;"
  >
    <div class="zure-cfg-loading">
      <div class="zure-cfg-spinner"></div>
      <p>Loading configurator...</p>
    </div>
  </div>

  {{ 'configurator.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'configurator.js' | asset_url }}" defer></script>
{% else %}
  <p style="padding: 16px; color: #888; font-size: 14px;">
    Zure Configurator: This block must be placed on a product page.
  </p>
{% endif %}

{% schema %}
{
  "name": "Zure Configurator",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "app_url",
      "label": "Configurator App URL",
      "info": "Your Zure Configurator app URL, e.g. https://zure-configurator-widget.vercel.app",
      "default": "https://zure-configurator-widget.vercel.app"
    },
    {
      "type": "checkbox",
      "id": "show_prices",
      "label": "Show price modifiers",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_required",
      "label": "Show required indicators",
      "default": true
    }
  ]
}
{% endschema %}
