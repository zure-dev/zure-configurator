// Zure Configurator — Database Schema
// Multi-tenant SaaS-ready from day one
// All entities are scoped to Store (tenant)

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// TENANT LAYER
// ──────────────────────────────────────────────

model Merchant {
  id        String   @id @default(cuid())
  name      String
  email     String?
  stores    Store[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("merchants")
}

model Store {
  id                 String   @id @default(cuid())
  merchantId         String
  merchant           Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shopifyDomain      String   @unique
  shopifyAccessToken String
  shopifyPlan        String?
  currency           String   @default("AUD")
  timezone           String   @default("Australia/Sydney")
  settings           Json?
  installedAt        DateTime @default(now())
  uninstalledAt      DateTime?

  productFamilies ProductFamily[]
  sessions        ConfigurationSession[]
  auditLogs       AuditLog[]

  @@map("stores")
}

// ──────────────────────────────────────────────
// PRODUCT FAMILY LAYER
// ──────────────────────────────────────────────

model ProductFamily {
  id          String @id @default(cuid())
  storeId     String
  store       Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  handle      String
  slug        String
  category    String?
  description String?
  status      ProductFamilyStatus @default(DRAFT)
  basePrice   Decimal             @default(0) @db.Decimal(10, 2)
  shopifyProductId String?
  defaultMediaSet Json?

  shopifyLink    ProductFamilyShopifyLink?
  variantProfiles ProductFamilyVariantProfile[]
  optionGroups   OptionGroup[]
  dependencyRules  OptionDependencyRule[]
  exclusionRules   OptionExclusionRule[]
  priceRules       PriceRule[]
  tradePriceRules  TradePriceRule[]
  mediaRules       MediaRule[]
  summaryRules     SummaryRule[]
  components       Component[]
  componentMaps    ConfigurationToComponentMap[]
  ruleVersions     RuleVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, handle])
  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([storeId, category])
  @@map("product_families")
}

enum ProductFamilyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ProductFamilyShopifyLink {
  id                   String        @id @default(cuid())
  productFamilyId      String        @unique
  productFamily        ProductFamily @relation(fields: [productFamilyId], references: [id], onDelete: Cascade)
  shopifyProductId     String
  shopifyProductNumericId String?
  shopifyVariantId     String?
  shopifyVariantNumericId String?
  shopifyProductHandle String?
  syncedAt             DateTime?

  @@index([shopifyProductId])
  @@map("product_family_shopify_links")
}

// ──────────────────────────────────────────────
// OPTION LAYER
// ──────────────────────────────────────────────

// ── Variant Profiles ──
// Each product family can have variant profiles (e.g. 900x480, 1200x480, 1500 Single).
// Option groups can be global (variantProfileId = null) or variant-specific.
model ProductFamilyVariantProfile {
  id              String        @id @default(cuid())
  productFamilyId String
  productFamily   ProductFamily @relation(fields: [productFamilyId], references: [id], onDelete: Cascade)

  name              String      // "900x480(D)x400mm"
  slug              String      // "900x480"
  shopifyVariantId  String?     // linked Shopify variant GID
  shopifyVariantTitle String?   // cached variant title
  shopifySku        String?     // cached SKU
  imageUrl          String?     // variant image
  sortOrder         Int         @default(0)
  isDefault         Boolean     @default(false)
  isActive          Boolean     @default(true)

  optionGroups OptionGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productFamilyId, slug])
  @@index([productFamilyId, sortOrder])
  @@map("product_family_variant_profiles")
}

model OptionGroup {
  id              String        @id @default(cuid())
  productFamilyId String
  productFamily   ProductFamily @relation(fields: [productFamilyId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  displayType     OptionDisplayType @default(TILE)
  sortOrder       Int           @default(0)
  isRequired      Boolean       @default(true)
  helperText      String?
  stepNumber      Int?

  // ── Variant Profile Assignment ──
  // null = global (applies to all variants)
  // set = only shows for this variant profile
  variantProfileId String?
  variantProfile   ProductFamilyVariantProfile? @relation(fields: [variantProfileId], references: [id], onDelete: SetNull)

  // ── Conditional Visibility ──
  isConditional        Boolean  @default(false)
  visibilityConditions Json?

  values OptionValue[]

  @@unique([productFamilyId, slug])
  @@index([productFamilyId, sortOrder])
  @@map("option_groups")
}

enum OptionDisplayType {
  SWATCH
  TILE
  THUMBNAIL
  DROPDOWN
  RADIO
  TOGGLE
}

model OptionValue {
  id            String      @id @default(cuid())
  optionGroupId String
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  sortOrder     Int         @default(0)
  isDefault     Boolean     @default(false)
  swatchColor   String?
  swatchImage   String?
  thumbnailUrl  String?
  description   String?
  metadata      Json?

  // ── Linked Shopify Product/Variant (Phase 1 — single product, kept as fallback) ──
  shopifyProductId    String?
  shopifyVariantId    String?
  shopifyProductTitle String?
  shopifyVariantTitle String?
  shopifySku          String?
  shopifyImageUrl     String?
  shopifyPrice        Decimal? @db.Decimal(10, 2)

  // ── Multi-Product Mappings (Sprint 2) ──
  // If productMappings exist, future cart/draft logic prefers them.
  // If empty, falls back to the single shopify* fields above.
  productMappings OptionValueProductMapping[]

  @@unique([optionGroupId, slug])
  @@index([optionGroupId, sortOrder])
  @@map("option_values")
}

// ── Option Value → Shopify Product/Variant Mapping (Sprint 2) ──
// One option value can map to multiple Shopify products/variants.
// Used for bundle resolution: e.g. "20mm Silksurface with Undermount Basin"
// maps to stone top variant + basin variant + waste variant.
model OptionValueProductMapping {
  id              String      @id @default(cuid())
  optionValueId   String
  optionValue     OptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  shopifyProductId    String                       // required: the Shopify product GID
  shopifyVariantId    String?                      // optional: specific variant
  shopifyProductTitle String?                      // cached for admin display
  shopifyVariantTitle String?                      // cached for admin display
  shopifySku          String?                      // cached SKU
  shopifyImageUrl     String?                      // cached image URL
  shopifyPrice        Decimal?  @db.Decimal(10, 2) // cached standalone price

  quantity    Int      @default(1)                 // how many of this product in the bundle
  sortOrder   Int      @default(0)                 // display order in admin
  role        String?                              // "component" | "included" | "addon" | "pricing_only"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([optionValueId, sortOrder])
  @@map("option_value_product_mappings")
}

// ──────────────────────────────────────────────
// RULE LAYER
// ──────────────────────────────────────────────

model OptionDependencyRule {
  id              String        @id @default(cuid())
  productFamilyId String
  productFamily   ProductFamily @relation(fields: [productFamilyId], references: [id], onDelete: Cascade)
  name            String?
  description     String?

  whenOptionGroupSlug  String
  whenOptionValueSlug  String
  thenOptionGroupSlug  String
  thenOptionValueSlugs String[]

  isActive      Boolean  @default(true)
  ruleVersionId String?
  sortOrder     Int      @default(0)

  @@index([productFamilyId, isActive])
  @@map("option_dependency_rules")
}

model OptionExclusionRule {
  id              String        @id @default(cuid())
  productFamilyId String
  productFamily   ProductFamily @relation(fields: [productFamilyId], references: [id], onDelete: Cascade)
  name            String?
  description     String?

  whenOptionGroupSlug  String
  whenOptionValueSlug  String
  excludeOptionGroupSlug  String
  excludeOptionValueSlugs String[]

  isActive      Boolean  @default(true)
  ruleVersionId String?
  sortOrder     Int      @default(0)

  @@index([productFamilyId, isActive])
  @@map("option_exclusion_rules")
}

model PriceRule {
  id              String        @id @default(cuid())
  productFamilyId String
  productFamily   ProductFamily @relation(fields: [productFamilyId], references: [id], onDelete: Cascade)
  name            String?

  optionGroupSlug String
  optionValueSlug String
  priceModifier   Decimal @db.Decimal(10, 2)
  modifierType    PriceModifierType @default(ADDITIVE)
  conditions Json?

  isActive      Boolean  @default(true)
  ruleVersionId String?
  sortOrder     Int      @default(0)

  @@index([productFamilyId, optionGroupSlug, optionValueSlug])
  @@map("price_rules")
}

model TradePriceRule {
  id              String        @id @default(cuid())
  productFamilyId String
  productFamily   ProductFamily @relation(fields: [productFamilyId], references: [id], onDelete: Cascade)
  name            String?

  optionGroupSlug String
  optionValueSlug String
  priceModifier   Decimal @db.Decimal(10, 2)
  modifierType    PriceModifierType @default(ADDITIVE)
  tradeCondition Json
  conditions Json?

  isActive      Boolean  @default(true)
  ruleVersionId String?
  sortOrder     Int      @default(0)

  @@index([productFamilyId, optionGroupSlug, optionValueSlug])
  @@map("trade_price_rules")
}

enum PriceModifierType {
  ADDITIVE
  PERCENTAGE
  ABSOLUTE
  OVERRIDE
}

model MediaRule {
  id              String        @id @default(cuid())
  productFamilyId String
  productFamily   ProductFamily @relation(fields: [productFamilyId], references: [id], onDelete: Cascade)
  name            String?
  priority        Int @default(0)
  conditions      Json
  mediaSet        Json
  isActive        Boolean  @default(true)
  ruleVersionId   String?

  @@index([productFamilyId, priority])
  @@map("media_rules")
}

model SummaryRule {
  id              String        @id @default(cuid())
  productFamilyId String
  productFamily   ProductFamily @relation(fields: [productFamilyId], references: [id], onDelete: Cascade)

  optionGroupSlug String
  template  String
  sortOrder Int @default(0)
  includeInLineItem Boolean @default(true)

  @@index([productFamilyId, sortOrder])
  @@map("summary_rules")
}

// ──────────────────────────────────────────────
// COMPONENT LAYER
// ──────────────────────────────────────────────

model Component {
  id              String        @id @default(cuid())
  productFamilyId String
  productFamily   ProductFamily @relation(fields: [productFamilyId], references: [id], onDelete: Cascade)
  name            String
  sku             String
  type            ComponentType
  shopifyProductId  String?
  shopifyVariantId  String?
  metadata        Json?

  inventoryPolicy InventoryPolicy?

  @@index([productFamilyId, type])
  @@index([sku])
  @@map("components")
}

enum ComponentType {
  CABINET
  STONE_TOP
  BASIN
  HANDLE
  ACCESSORY
  TAP
  PLUG_WASTE
  OTHER
}

model ConfigurationToComponentMap {
  id              String        @id @default(cuid())
  productFamilyId String
  productFamily   ProductFamily @relation(fields: [productFamilyId], references: [id], onDelete: Cascade)
  conditions Json
  componentId String
  quantity    Int @default(1)

  @@index([productFamilyId])
  @@map("configuration_to_component_maps")
}

// ──────────────────────────────────────────────
// INVENTORY
// ──────────────────────────────────────────────

model InventoryPolicy {
  id            String @id @default(cuid())
  componentId   String @unique
  component     Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  trackingMode      InventoryTrackingMode @default(NONE)
  currentStock      Int?
  lowStockThreshold Int?
  leadTimeDays      Int?
  metadata          Json?

  updatedAt DateTime @updatedAt

  @@map("inventory_policies")
}

enum InventoryTrackingMode {
  NONE
  SOFT
  HARD
}

// ──────────────────────────────────────────────
// SESSION & SNAPSHOT LAYER
// ──────────────────────────────────────────────

model ConfigurationSession {
  id              String @id @default(cuid())
  storeId         String
  store           Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productFamilyId String
  shopifyProductId String?
  customerIdent   String?
  isTradeCustomer Boolean @default(false)

  selections    Json
  resolvedPrice Decimal? @db.Decimal(10, 2)

  status    SessionStatus @default(ACTIVE)
  expiresAt DateTime

  snapshot ConfigurationSnapshot?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, status])
  @@index([customerIdent])
  @@index([expiresAt])
  @@map("configuration_sessions")
}

enum SessionStatus {
  ACTIVE
  RESOLVED
  EXPIRED
  ABANDONED
}

model ConfigurationSnapshot {
  id        String               @id @default(cuid())
  sessionId String               @unique
  session   ConfigurationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  productFamilyId String
  ruleVersionId   String

  selections        Json
  pricingBreakdown  Json
  mediaState        Json
  componentMappings Json
  tradeState        Json?

  summaryText       String
  summaryStructured Json

  validationSignature String

  cartResolution CartResolutionRecord?

  createdAt DateTime @default(now())

  @@index([productFamilyId])
  @@map("configuration_snapshots")
}

model CartResolutionRecord {
  id         String                @id @default(cuid())
  snapshotId String                @unique
  snapshot   ConfigurationSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  shopifyCartToken    String?
  shopifyVariantId    String
  lineItemProperties  Json
  resolvedPrice       Decimal @db.Decimal(10, 2)

  orderResolution OrderResolutionRecord?

  createdAt DateTime @default(now())

  @@index([shopifyCartToken])
  @@map("cart_resolution_records")
}

model OrderResolutionRecord {
  id               String               @id @default(cuid())
  cartResolutionId String               @unique
  cartResolution   CartResolutionRecord @relation(fields: [cartResolutionId], references: [id], onDelete: Cascade)

  shopifyOrderId    String?
  shopifyOrderName  String?
  shopifyLineItemId String?

  componentSkus    Json
  stockLogicState  Json?
  leadTimeState    Json?

  fulfilmentStatus String?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopifyOrderId])
  @@map("order_resolution_records")
}

// ──────────────────────────────────────────────
// VERSIONING & AUDIT
// ──────────────────────────────────────────────

model RuleVersion {
  id              String        @id @default(cuid())
  productFamilyId String
  productFamily   ProductFamily @relation(fields: [productFamilyId], references: [id], onDelete: Cascade)
  version         Int
  description     String?
  snapshotData Json
  publishedAt DateTime?
  createdBy   String?
  createdAt DateTime @default(now())

  @@unique([productFamilyId, version])
  @@map("rule_versions")
}

model AuditLog {
  id       String @id @default(cuid())
  storeId  String
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId   String?
  userName String?

  action     AuditAction
  entityType String
  entityId   String

  before   Json?
  after    Json?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  IMPORT
  EXPORT
  ACTIVATE
  DEACTIVATE
  ARCHIVE
}

// ──────────────────────────────────────────────
// OPTION GROUP CLIPBOARD / TEMPLATES
// ──────────────────────────────────────────────

model OptionGroupClipboard {
  id        String   @id @default(cuid())
  storeId   String
  label     String?
  data      Json
  isTemplate Boolean @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@index([storeId, createdAt])
  @@map("option_group_clipboard")
}
